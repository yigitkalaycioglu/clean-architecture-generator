<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- WebUI: MVC sunum katmanı. Controller'lar yalnızca Business katmanındaki servis arayüzlerini kullanır. -->
  <ItemGroup>
    <ProjectReference Include="..\__Name__.Business\__Name__.Business.csproj" />
    <ProjectReference Include="..\__Name__.Core\__Name__.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />
    <!-- Migration komutları (dotnet ef / Add-Migration) için; yayınlanan uygulamaya dahil edilmez. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
