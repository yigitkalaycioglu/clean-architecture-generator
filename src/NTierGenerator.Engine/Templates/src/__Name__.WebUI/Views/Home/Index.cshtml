@{
    ViewData["Title"] = "Ana sayfa";
}

<div class="py-5 text-center">
    <h1 class="display-6 fw-semibold">__Name__</h1>
    <p class="lead text-muted">Katmanlı (N-Tier) mimari ile oluşturulmuş ASP.NET Core MVC uygulaması.</p>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    <div class="col">
        <div class="card h-100 layer-card">
            <div class="card-body">
                <h2 class="h6 card-title">WebUI</h2>
                <p class="card-text text-muted">Sunum katmanı. Controller'lar yalnızca Business servislerini çağırır.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 layer-card">
            <div class="card-body">
                <h2 class="h6 card-title">Business</h2>
                <p class="card-text text-muted">İş kuralları, doğrulama ve aspect'ler (cache, performans, yetki).</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 layer-card">
            <div class="card-body">
                <h2 class="h6 card-title">DataAccess</h2>
                <p class="card-text text-muted">EF Core ile veritabanı erişimi: DbContext, Dal sınıfları ve tablo ayarları.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 layer-card">
            <div class="card-body">
                <h2 class="h6 card-title">Entities</h2>
                <p class="card-text text-muted">Veritabanı varlıkları ve katmanlar arası veri taşıyan DTO'lar.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 layer-card">
            <div class="card-body">
                <h2 class="h6 card-title">Core</h2>
                <p class="card-text text-muted">Projeden bağımsız altyapı: generic repository, sonuç tipleri, AOP, cache.</p>
            </div>
        </div>
    </div>
</div>
