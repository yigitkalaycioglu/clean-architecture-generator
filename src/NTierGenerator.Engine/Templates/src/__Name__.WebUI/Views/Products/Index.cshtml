@*#if Sample*@
@model List<ProductDetailDto>
@{
    ViewData["Title"] = "Ürünler";
}

<h1 class="h3 mb-4">Ürünler</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Henüz ürün yok. Web API üzerinden ya da veritabanına doğrudan kayıt ekleyebilirsiniz.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Ürün</th>
                    <th>Kategori</th>
                    <th class="text-end">Birim fiyat</th>
                    <th class="text-end">Stok</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.ProductName</td>
                        <td>@product.CategoryName</td>
                        <td class="text-end">@product.UnitPrice.ToString("C")</td>
                        <td class="text-end">@product.UnitsInStock</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@*#endif*@
