<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core: projeden bağımsız, başka projelerde de kullanılabilecek altyapı katmanı.
    Diğer katmanlara bağımlı değildir; tüm katmanlar Core'u kullanır.
  -->
  <ItemGroup>
    <!-- IHttpContextAccessor, IMemoryCache, DI, Logging gibi ASP.NET Core türleri için paylaşımlı çerçeve -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extras.DynamicProxy" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
<!--#if Auth-->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
<!--#endif-->
  </ItemGroup>

</Project>
