{
  "ConnectionStrings": {
    "DefaultConnection": "__ConnectionString__"
  },
//#if Auth
  "TokenOptions": {
    "Audience": "__Name__.Client",
    "Issuer": "__Name__.WebAPI",
    "AccessTokenExpiration": 60,
    "SecurityKey": "__JwtSecret__"
  },
//#endif
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:4200", "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
