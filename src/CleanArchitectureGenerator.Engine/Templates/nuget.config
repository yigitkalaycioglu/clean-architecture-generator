<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Paketler yalnızca nuget.org'dan indirilir (makinedeki diğer kaynaklar devre dışı). Package Source Mapping,
    her paketin hangi kaynaktan gelebileceğini sabitler ve "dependency confusion" saldırılarını önler.
    Şirket içi bir kaynak eklerseniz, o kaynaktan gelecek paketlerin adlarını kendi packageSource altına yazın.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
