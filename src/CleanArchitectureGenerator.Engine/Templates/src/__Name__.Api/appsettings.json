{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
//#if LocalAuth
  "Jwt": {
    "Issuer": "__Name__",
    "Audience": "__Name__",
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 14
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "From": ""
  },
//#else
  "Authentication": {
    "Authority": "",
    "Audience": ""
  },
//#endif
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "AuthenticationPermitLimit": 10,
    "WindowSeconds": 60
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
